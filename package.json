{
  "name": "aquastock",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "reset-packages": "node scripts/reset-modules.js",
    "list-packages": "node scripts/list-modules.js",
    "dev:clean": "node scripts/dev-clean.js",
    "clean:cache": "node scripts/clean-next-cache.js",
    "clean:workspace": "node scripts/reset-modules.js --with-lockfile",
    "dev": "turbo run dev --filter=web --filter=dapp",
    "dev:all": "turbo run dev",
    "dev:web": "turbo run dev --filter=web",
    "dev:dapp": "turbo run dev --filter=dapp",
    "audit:cache": "node scripts/audit-vercel-cache.mjs",
    "secrets:scan": "bash scripts/scan-secrets.sh",
    "hooks:install": "git config core.hooksPath scripts/git-hooks",
    "claude:new-session": "script -qec \"claude --remote-control mobile-$(date +%s)\" /dev/null",
    "claude:close-sessions": "node scripts/claude-close-sessions.js",
    "codex:new-session": "codex remote-control start",
    "codex:close-sessions": "codex remote-control stop",
    "build:dapp": "turbo run build --filter=dapp",
    "program:build": "bash scripts/anchor.sh build --arch v0 --ignore-keys",
    "program:test": "bash scripts/program-test.sh",
    "program:fixtures": "bash scripts/fetch-token2022-fixture.sh",
    "program:idl": "bash scripts/program-idl.sh",
    "program:keygen": "bash scripts/program-keygen.sh",
    "program:deploy": "bash scripts/program-deploy.sh",
    "dev:stack": "bash scripts/dev-stack.sh",
    "program:localnet": "bash scripts/localnet.sh",
    "program:smoke": "bash scripts/program-smoke.sh",
    "check-types:scripts": "tsc -p scripts/solana/tsconfig.json",
    "solana:replica-mint": "tsx scripts/solana/replica-mint.ts",
    "solana:mint-replica": "tsx scripts/solana/mint-replica.ts",
    "solana:init-config": "tsx scripts/solana/init-config.ts",
    "solana:demo-pool": "tsx scripts/solana/demo-pool.ts",
    "solana:faucet": "tsx scripts/solana/faucet-setup.ts",
    "demo:preflight": "tsx scripts/solana/preflight.ts",
    "video:install": "pnpm --dir video install",
    "video:studio": "pnpm --dir video studio",
    "video:capture": "pnpm --dir video capture",
    "video:render": "pnpm --dir video render",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,cjs,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,cjs,json,md,yml,yaml}\"",
    "check": "pnpm format && turbo run lint check-types test build",
    "test:e2e": "pnpm --filter dapp test:e2e"
  },
  "devDependencies": {
    "@aquastock/config": "workspace:*",
    "prettier": "^3.8.1",
    "turbo": "^2.8.10",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@10.30.1",
  "engines": {
    "node": ">=18"
  }
}
