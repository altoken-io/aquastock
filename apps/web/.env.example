# ============================================================================
# AQUASTOCK WEB - ENVIRONMENT VARIABLES
# ============================================================================
# Copy this file to .env.local and fill in the values for the landing site.
# Never commit .env.local to version control.
# ============================================================================

# ----------------------------------------------------------------------------
# APPLICATION URLS
# ----------------------------------------------------------------------------
# Public URL of the web landing site.
# Development: http://localhost:3000
# Production: https://aquastock.io
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ----------------------------------------------------------------------------
# DATABASE
# ----------------------------------------------------------------------------
# Shared Postgres used by Prisma (packages/db-prisma) for the off-chain
# project/position/milestone/impact cache. DATABASE_URL should use the
# pooled connection for app runtime; DIRECT_URL the direct connection for
# migrations.
DATABASE_URL=postgresql://postgres.PROJECT_ID:PASSWORD@aws-1-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.PROJECT_ID:PASSWORD@aws-1-sa-east-1.pooler.supabase.com:5432/postgres

# ----------------------------------------------------------------------------
# EMAIL FORMS (RESEND)
# ----------------------------------------------------------------------------
# Used by contact and newsletter forms.
# Get your API key at: https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key
RESEND_NEWSLETTER_AUDIENCE_ID=your_newsletter_segment_id

# ----------------------------------------------------------------------------
# RATE LIMITING AND BOT PROTECTION
# ----------------------------------------------------------------------------
# Upstash Redis powers form rate limits.
UPSTASH_REDIS_REST_URL=https://your-upstash-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token

# Arcjet protects server-side form endpoints in production. Optional locally.
ARCJET_KEY=ajkey_your_arcjet_key

# ----------------------------------------------------------------------------
# ANALYTICS (POSTHOG)
# ----------------------------------------------------------------------------
# PostHog project API key for analytics and feature flags.
# Get from: https://app.posthog.com/project/settings
NEXT_PUBLIC_POSTHOG_KEY=phc_your_project_key

# PostHog API host. US: https://us.i.posthog.com — EU: https://eu.i.posthog.com
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ----------------------------------------------------------------------------
# SEARCH ENGINE VERIFICATION
# ----------------------------------------------------------------------------
# Google Search Console "HTML tag" verification token. Renders as
# <meta name="google-site-verification"> in <head>.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
