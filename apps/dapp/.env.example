# ============================================================================
# AQUASTOCK DAPP - ENVIRONMENT VARIABLES
# ============================================================================
# Copy this file to .env.local and fill in the values.
# Never commit .env.local to version control.
# ============================================================================

# ----------------------------------------------------------------------------
# APPLICATION URLS
# ----------------------------------------------------------------------------
# Base URL of the dApp itself.
# Development: http://localhost:3003
# Production: https://app.aquastock.io
NEXT_PUBLIC_BASE_URL=http://localhost:3003

# Public URL of apps/web — used for links back to the marketing site. Falls
# back to https://aquastock.io if unset, so set this locally or those links
# will leave localhost.
# Development: http://localhost:3000
# Production: https://aquastock.io
NEXT_PUBLIC_WEB_URL=http://localhost:3000

# ----------------------------------------------------------------------------
# SOLANA
# ----------------------------------------------------------------------------
# Cluster the Anchor program is deployed to during the hackathon build.
NEXT_PUBLIC_SOLANA_NETWORK=devnet

# RPC endpoint used by the wallet-adapter connect flow and on-chain reads.
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# Deployed Anchor program id (base58 pubkey). Empty until the program
# (see docs/ARCHITECTURE.md) is deployed.
NEXT_PUBLIC_ANCHOR_PROGRAM_ID=

# ----------------------------------------------------------------------------
# DATABASE (Prisma/Postgres — off-chain project/position/milestone/impact cache)
# ----------------------------------------------------------------------------
# Required — the admin console's login (Better Auth session/user tables)
# needs a real Postgres to work, even in dev. Point this at the disposable
# local Postgres in docker-compose.dev.yml, or a Supabase/other hosted
# instance. The investor-facing UI itself reads from a static demo dataset,
# not this database (see docs/ROADMAP.md), so nothing else here depends on it.
DATABASE_URL=postgresql://postgres:password@localhost:5432/aquastock?schema=public
DIRECT_URL=postgresql://postgres:password@localhost:5432/aquastock?schema=public

# ----------------------------------------------------------------------------
# ADMIN CONSOLE AUTH (Better Auth — staff/government login, not investor auth)
# ----------------------------------------------------------------------------
# Session/cookie signing secret. Optional in dev (falls back to a disabled
# placeholder) but required in production. Generate with:
#   openssl rand -base64 32
# There is no public sign-up route — create accounts with:
#   pnpm --filter @aquastock/db-prisma create-admin-user -- --email you@x.com --name "Your Name"
BETTER_AUTH_SECRET=

# ----------------------------------------------------------------------------
# EMAIL SERVICE (RESEND)
# ----------------------------------------------------------------------------
# Only actually used by the admin console's "Forgot password" reset-link
# email (src/lib/auth/auth.ts). Optional in dev — skip it unless you need
# to test that specific flow; signing in directly never touches Resend.
RESEND_API_KEY=re_your_api_key_here
RESEND_NEWSLETTER_AUDIENCE_ID=your_audience_id_here

# ----------------------------------------------------------------------------
# ANALYTICS (POSTHOG)
# ----------------------------------------------------------------------------
NEXT_PUBLIC_POSTHOG_KEY=phc_your_project_key_here
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ----------------------------------------------------------------------------
# SECURITY
# ----------------------------------------------------------------------------
# https://launch.arcjet.com — bot/abuse protection middleware.
ARCJET_KEY=

# ----------------------------------------------------------------------------
# REDIS (Upstash REST — rate limiting)
# ----------------------------------------------------------------------------
# Not currently on any reachable code path (the contact/newsletter forms and
# auth-form rate limiter that use this aren't rendered on any live page yet)
# — safe to leave empty for local development.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
