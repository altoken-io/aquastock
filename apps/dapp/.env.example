# ============================================================================
# AQUASTOCK DAPP - ENVIRONMENT VARIABLES
# ============================================================================
# Copy this file to .env.local and fill in the values.
# Never commit .env.local to version control.
# ============================================================================

# ----------------------------------------------------------------------------
# APPLICATION URLS
# ----------------------------------------------------------------------------
# Base URL of the dApp itself.
# Development: http://localhost:3003
# Production: https://app.aquastock.io
NEXT_PUBLIC_BASE_URL=http://localhost:3003

# Public URL of apps/web — used for links back to the marketing site. Falls
# back to https://aquastock.io if unset, so set this locally or those links
# will leave localhost.
# Development: http://localhost:3000
# Production: https://aquastock.io
NEXT_PUBLIC_WEB_URL=http://localhost:3000

# ----------------------------------------------------------------------------
# SOLANA
# ----------------------------------------------------------------------------
# Cluster the Anchor program is deployed to during the hackathon build.
NEXT_PUBLIC_SOLANA_NETWORK=devnet

# RPC endpoint used by the wallet-adapter connect flow and on-chain reads.
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# Deployed Anchor program id (base58 pubkey). Empty until the program
# (see docs/ARCHITECTURE.md) is deployed.
NEXT_PUBLIC_ANCHOR_PROGRAM_ID=

# Server-only RPC endpoint for route handlers (reading pools and positions,
# verifying transactions). Use a provider key here (Helius, QuickNode) and keep
# it out of NEXT_PUBLIC_*. Falls back to NEXT_PUBLIC_SOLANA_RPC_URL if unset,
# and to a local validator in development.
SOLANA_RPC_URL=

# The one Token-2022 mint this deployment allows: mainnet SPYx
# (XsoCS1TfEyfFhfvj8EtZ528L3CaKBDBRqRapnBbDF2W) or the devnet replica created by
# `pnpm solana:replica-mint`. It must equal the mint passed to `init_config`.
NEXT_PUBLIC_STOCK_MINT=

# Server-only. Demo faucet wallet for devnet/localnet (POST /api/faucet), as the
# JSON array a Solana keypair file holds. Create and fund it with
# `pnpm solana:faucet`, then paste the contents of its keypair file here. A
# dedicated wallet holding only demo tokens and a little SOL: never the
# deployer, upgrade or mint authority. Ignored on mainnet. Unset = no faucet.
FAUCET_SECRET_KEY=

# Server-only. Pyth API key (https://pythdata.app) for live SPYx/USD prices
# from Hermes, used to show "≈ $" next to token amounts. Unset hides them;
# The key's account must be entitled to Crypto.SPYX/USD (the feed's data grant
# in Pyth Terminal), or Hermes answers 403. Unset or refused: the app falls back
# to Jupiter's keyless SPYx price, and the price card names the source.
PYTH_API_KEY=
# Optional. Hermes base URL, https only. Defaults to Pyth's recommended
# https://pyth.dourolabs.app/hermes; set https://hermes.pyth.network for the legacy host.
PYTH_HERMES_URL=

# Mainnet only: the most a pool's match budget, and each saver's limit, may be, in token units
# (for example 10). If the network is mainnet and this is unset or unreadable, creating pools is
# closed rather than left unlimited. Other networks ignore it. This limits the interface, not the
# program: anyone can still call the program directly.
NEXT_PUBLIC_MAINNET_DEMO_CAP=

# Test-only. Leave unset. `pnpm dev:stack` and the Playwright suite set it to a throwaway local
# keypair so a browser can act as a wallet without an extension; the app registers it only when
# NEXT_PUBLIC_SOLANA_NETWORK is `localnet`, and it is stripped from every other build.
# NEXT_PUBLIC_E2E_WALLET_SECRET=

# ----------------------------------------------------------------------------
# DATABASE (Prisma/Postgres — pool metadata and verified activity; the chain is the source of truth)
# ----------------------------------------------------------------------------
# Required — the admin console's login (Better Auth session/user tables)
# needs a real Postgres to work, even in dev. Point this at the disposable
# local Postgres in docker-compose.dev.yml, or a Supabase/other hosted
# instance. The investor-facing UI itself reads from a static demo dataset,
# not this database (see docs/ROADMAP.md), so nothing else here depends on it.
DATABASE_URL=postgresql://postgres:password@localhost:5432/aquastock?schema=public
DIRECT_URL=postgresql://postgres:password@localhost:5432/aquastock?schema=public
# Optional: connections one server instance keeps open (default 5).
# DATABASE_POOL_MAX=

# ----------------------------------------------------------------------------
# ADMIN CONSOLE AUTH (Better Auth — staff/government login, not investor auth)
# ----------------------------------------------------------------------------
# Session/cookie signing secret. Optional in dev (falls back to a disabled
# placeholder) but required in production. Generate with:
#   openssl rand -base64 32
# There is no public sign-up route — create accounts with:
#   pnpm --filter @aquastock/db-prisma create-admin-user -- --email you@x.com --name "Your Name"
BETTER_AUTH_SECRET=

# ----------------------------------------------------------------------------
# EMAIL SERVICE (RESEND)
# ----------------------------------------------------------------------------
# Only actually used by the admin console's "Forgot password" reset-link
# email (src/lib/auth/auth.ts). Optional in dev — skip it unless you need
# to test that specific flow; signing in directly never touches Resend.
RESEND_API_KEY=re_your_api_key_here
RESEND_NEWSLETTER_AUDIENCE_ID=your_audience_id_here

# ----------------------------------------------------------------------------
# ANALYTICS (POSTHOG)
# ----------------------------------------------------------------------------
NEXT_PUBLIC_POSTHOG_KEY=phc_your_project_key_here
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ----------------------------------------------------------------------------
# SECURITY
# ----------------------------------------------------------------------------
# https://launch.arcjet.com — bot/abuse protection middleware.
ARCJET_KEY=

# ----------------------------------------------------------------------------
# REDIS (Upstash REST — rate limiting)
# ----------------------------------------------------------------------------
# Not currently on any reachable code path (the contact/newsletter forms and
# auth-form rate limiter that use this aren't rendered on any live page yet)
# — safe to leave empty for local development.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
